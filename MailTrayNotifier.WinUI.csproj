<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <OutputType>WinExe</OutputType>

        <!-- 출력 실행 파일 이름 (RootNamespace와 독립). 패키지/StartupTask Executable에 반영됨 -->
        <AssemblyName>MailTrayNotifier</AssemblyName>

        <!-- WinUI 3 (MSIX 패키지 앱) -->
        <UseWinUI>true</UseWinUI>
        <EnableMsixTooling>true</EnableMsixTooling>

        <!-- Project Options -->
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>MailTrayNotifier.WinUI</RootNamespace>

        <!-- 단일 인스턴스/알림 활성화 리디렉션을 위해 커스텀 진입점(Program.Main) 사용 -->
        <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

        <!-- 앱 메타데이터 (Windows 알림에 표시될 앱 이름 포함) -->
        <AssemblyTitle>메일 알리미</AssemblyTitle>
        <Product>메일 알리미</Product>
        <Version>1.7.0</Version>
        <AssemblyVersion>1.7.0</AssemblyVersion>
        <FileVersion>1.7.0</FileVersion>

        <!-- WinUIEx의 deprecated 타입(WinUIEx.Icon)이 자동생성 XamlTypeInfo.g.cs에 포함되어
             발생하는 CS0612만 억제(우리 소스에는 deprecated API 사용 없음). -->
        <NoWarn>$(NoWarn);CS0612</NoWarn>

        <!-- App Options -->
        <UseRidGraph>true</UseRidGraph>
        <Platforms>x86;x64;ARM64</Platforms>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <PublishProfile>win-$(Platform).pubxml</PublishProfile>
        <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')) &gt;= 8">win-x86;win-x64;win-arm64</RuntimeIdentifiers>
        <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')) &lt; 8">win10-x86;win10-x64;win10-arm64</RuntimeIdentifiers>
        <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
        <AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
        <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
        <AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
        <GenerateTestArtifacts>False</GenerateTestArtifacts>
        <AppxBundle>Never</AppxBundle>
        <GenerateTemporaryStoreCertificate>True</GenerateTemporaryStoreCertificate>
        <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Assets\SplashScreen.scale-200.png" />
        <Content Include="Assets\LockScreenLogo.scale-200.png" />
        <Content Include="Assets\Square150x150Logo.scale-200.png" />
        <Content Include="Assets\Square44x44Logo.scale-200.png" />
        <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
        <Content Include="Assets\Wide310x150Logo.scale-200.png" />
        <!-- 트레이 아이콘(.ico)은 파일 경로로 LoadImage 하므로 출력 폴더로 복사 -->
        <Content Include="Assets\start.ico" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Assets\stop.ico" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Assets\warning.ico" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Assets\icon.png" CopyToOutputDirectory="PreserveNewest" />
        <!-- 작업 표시줄/창 아이콘(.ico)은 파일 경로로 AppWindow.SetIcon 하므로 출력 폴더로 복사 -->
        <Content Include="Assets\appicon.ico" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Assets\appicon.png" />
        <None Remove="MailTrayNotifier.WinUI.slnx" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
        <PackageReference Include="MailKit" Version="4.17.0" />
        <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.9" />
        <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.*" />

        <Manifest Include="$(ApplicationManifest)" />

        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />

        <PackageReference Include="WinUIEx" Version="2.9.1" />
    </ItemGroup>

    <!-- 
        Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
        Tools extension to be activated for this project even if the Windows App SDK Nuget
        package has not yet been restored.
    -->
    <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
        <ProjectCapability Include="Msix" />
    </ItemGroup>

    <!-- 
        Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution 
        Explorer "Package and Publish" context menu entry to be enabled for this project even if 
        the Windows App SDK Nuget package has not yet been restored.
    -->
    <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
        <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
    </PropertyGroup>
</Project>
