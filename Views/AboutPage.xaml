<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MailTrayNotifier.WinUI.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="6">

            <TextBlock x:Uid="AbTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="AbSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

            <!-- 앱 정보 카드 -->
            <controls:SettingsCard Header="{Binding AppDisplayName}" Description="{Binding AppVersionText}">
                <!-- SettingsCard 기본 헤더 아이콘 최대 크기(20px) 제한을 64px로 확대 -->
                <controls:SettingsCard.Resources>
                    <x:Double x:Key="SettingsCardHeaderIconMaxSize">64</x:Double>
                </controls:SettingsCard.Resources>
                <controls:SettingsCard.HeaderIcon>
                    <ImageIcon Width="64" Height="64" Source="ms-appx:///Assets/appicon.png" />
                </controls:SettingsCard.HeaderIcon>
                <HyperlinkButton x:Uid="AbOfficialSite" Tag="{Binding OfficialWebsiteUrl}" Click="OnLinkClick" />
            </controls:SettingsCard>

            <!-- 데이터 저장 안내 카드 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="16,14">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE72E;" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock x:Uid="AbDataTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Uid="AbDataDesc"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 오픈소스 라이선스 -->
            <TextBlock x:Uid="AbOpenSourceTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,4" />
            <ItemsControl ItemsSource="{Binding OpenSourceLibraries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:SettingsCard Header="{Binding Name}" Description="{Binding License}"
                                               IsClickEnabled="True" Tag="{Binding Url}"
                                               Click="OnLicenseCardClick" Margin="0,0,0,4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
